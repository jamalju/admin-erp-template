@{
    ViewData["Title"] = "Tax Reports";
    ViewData["BreadcrumbParent"] = "Accounting";
    ViewData["BreadcrumbParentUrl"] = "#";
}


<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-percent"></i> Tax Reports</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Period</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var report in (List<AdminErpTemplate.Web.Models.TaxReport>)Model)
            {
                <tr>
                    <td>@report.Id</td>
                    <td>@report.Period</td>
                    <td>@report.Amount.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
