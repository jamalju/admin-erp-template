@{
    ViewData["Title"] = "Expenses";
    ViewData["BreadcrumbParent"] = "Accounting";
    ViewData["BreadcrumbParentUrl"] = "#";
}


<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-credit-card"></i> Expenses</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var expense in (List<AdminErpTemplate.Web.Models.Expense>)Model)
            {
                <tr>
                    <td>@expense.Id</td>
                    <td>@expense.Description</td>
                    <td>@expense.Date.ToShortDateString()</td>
                    <td>@expense.Amount.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
