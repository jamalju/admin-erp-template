@{
    ViewData["Title"] = "Orders";
    ViewData["BreadcrumbParent"] = "E-Commerce";
    ViewData["BreadcrumbParentUrl"] = "#";
}




<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-receipt"></i> Orders</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in (List<AdminErpTemplate.Web.Models.Order>)Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.Customer</td>
                    <td>@order.Date.ToShortDateString()</td>
                    <td>@order.Total.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
