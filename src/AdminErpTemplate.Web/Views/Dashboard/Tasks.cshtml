@{
    ViewData["Title"] = "Tasks";
    ViewData["BreadcrumbParent"] = "Project Management";
    ViewData["BreadcrumbParentUrl"] = "#";
}


<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-list-check"></i> Tasks</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var task in (List<AdminErpTemplate.Web.Models.TaskItem>)Model)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>@task.Title</td>
                    <td>@task.AssignedTo</td>
                    <td>@task.Status</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
