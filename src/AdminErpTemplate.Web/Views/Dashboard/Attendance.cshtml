@{
    ViewData["Title"] = "Attendance";
    ViewData["BreadcrumbParent"] = "HRM";
    ViewData["BreadcrumbParentUrl"] = "#";
}


<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-calendar-check"></i> Attendance</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Employee</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var record in (List<AdminErpTemplate.Web.Models.AttendanceRecord>)Model)
            {
                <tr>
                    <td>@record.Id</td>
                    <td>@record.Employee</td>
                    <td>@record.Date.ToShortDateString()</td>
                    <td>@record.Status</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
