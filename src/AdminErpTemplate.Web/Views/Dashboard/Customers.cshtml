@{
    ViewData["Title"] = "Customers";
    ViewData["BreadcrumbParent"] = "E-Commerce";
    ViewData["BreadcrumbParentUrl"] = "#";
}


<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-people"></i> Customers</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var customer in (List<AdminErpTemplate.Web.Models.Customer>)Model)
            {
                <tr>
                    <td>@customer.Id</td>
                    <td>@customer.Name</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
<div class="dash-card">
    <div class="dash-card-body">
        <div class="placeholder-page">
            <div class="placeholder-icon"><i class="bi bi-people"></i></div>
            <h3>Customers</h3>
            <p>This is a placeholder for the Customers module. Connect this page to your backend API to display real data from your ERP system.</p>
            <div class="mt-4">
                <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
                <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
            </div>
        </div>
    </div>
</div>
