@{
    ViewData["Title"] = "Tax Settings";
    ViewData["BreadcrumbParent"] = "Accounting";
    ViewData["BreadcrumbParentUrl"] = "#";
}


<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-percent"></i> Tax Settings</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Rate</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var setting in (List<AdminErpTemplate.Web.Models.TaxSetting>)Model)
            {
                <tr>
                    <td>@setting.Id</td>
                    <td>@setting.Name</td>
                    <td>@setting.Rate.ToString("P0")</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
