@{
    ViewData["Title"] = "Invoices";
    ViewData["BreadcrumbParent"] = "Accounting";
    ViewData["BreadcrumbParentUrl"] = "#";
}


<div class="dash-card">
    <div class="dash-card-body">
        <h3><i class="bi bi-file-earmark-text"></i> Invoices</h3>
        <table class="erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var invoice in (List<AdminErpTemplate.Web.Models.Invoice>)Model)
            {
                <tr>
                    <td>@invoice.Id</td>
                    <td>@invoice.Customer</td>
                    <td>@invoice.Date.ToShortDateString()</td>
                    <td>@invoice.Amount.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4">
            <a href="/Dashboard" class="btn btn-primary me-2"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>Add New</button>
        </div>
    </div>
</div>
